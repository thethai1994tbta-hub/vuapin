# Firebase Configuration
# Set FIREBASE_CREDENTIALS to the entire JSON content from your Firebase service account key

# Example (on one line, without newlines):
# FIREBASE_CREDENTIALS={"type":"service_account","project_id":"gen-lang-client-0661551951",...full json here...}

# Email Configuration
EMAIL_SENDER=your-gmail@gmail.com
EMAIL_PASSWORD=your-app-password-16-chars

# Flask Configuration
FLASK_ENV=production
